---
import { Icon } from "astro-icon/components";

import { render } from "astro:content";

interface Props {
    authors: string;
    year: number;
    title: string;
    venue: string;
    url: string;
    content: any;
}

const { authors, year, title, venue, url, content } = Astro.props;
const { Content } = await render(content);
---

<article class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
    <div class="col-span-2">
        <h3 class="mb-2 md:text-lg">
            <span>{authors}</span>&nbsp;
            <span class="opacity-60">({year}).</span>&nbsp;
            <span class="font-bold">{title}.</span>&nbsp;
            <span class="text-sm md:text-base italic font-light">{venue}</span>
        </h3>
        <section class="text-sm">
            <Content />
        </section>
    </div>
    <footer class="text-sm font-bold">
        <a class="text-figred flex content-center" href={url} target="_blank">
            <Icon class="inline mr-2 text-2xl" name="tdesign:link" />
            <span class="underline self-center">{url}</span>
        </a>
    </footer>
</article>
