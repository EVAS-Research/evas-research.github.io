---
import { Icon } from "astro-icon/components";

import ResearchItem from "@/components/ResearchItem.astro";

interface Props {
    items: Array<any>;
}

const { items } = Astro.props;
---

<div class="flex gap-4 items-center max-w-3xl">
    <label for="search">
        <Icon name="tdesign:search" class="text-figred text-3xl" />
    </label>
    <input
        id="search"
        type="text"
        class="border-3 border-figred py-2 px-4 w-full focus:outline-none"
        placeholder="search for authors or keywords"
    />
    <button>
        <Icon name="tdesign:filter-clear" class="text-figred text-3xl" />
    </button>
</div>
<div class="grid grid-cols-1 gap-8">
    {items.map((item) => <ResearchItem {...item.data} content={item} />)}
</div>
