---
import { Icon } from "astro-icon/components";

import { render } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    name: string;
    picture: ImageMetadata;
    website: string;
    research: string;
    content: any;
}

const { name, picture, website, research, content } = Astro.props;
const { Content } = await render(content);

const SOCIALS = [
    { icon: "tdesign:assignment-user", name: "visit the human", url: website },
    {
        icon: "tdesign:folder-search",
        name: "follow the research",
        url: research,
    },
];
---

<article
    class="flex flex-col sm:flex-row lg:flex-col items-center justify-center gap-4"
>
    <div class="shrink-0 w-64 h-64 bg-figred rounded-full mb-2">
        <Image class="w-full h-auto" src={picture} alt={name} />
    </div>
    <div class="shrink">
        <h3 class="font-bold text-3xl mb-1.5">{name}</h3>
        <div class="text-sm mb-4">
            <Content />
        </div>
        <div class="flex gap-4">
            {
                SOCIALS.map((social) => (
                    <a
                        class="text-figred flex content-center"
                        href={social.url}
                        target="_blank"
                    >
                        <Icon class="inline mr-2 text-2xl" name={social.icon} />
                        <span class="underline self-center">{social.name}</span>
                    </a>
                ))
            }
        </div>
    </div>
</article>
