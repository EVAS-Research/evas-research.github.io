---
import { Icon } from "astro-icon/components";

import { render } from "astro:content";
import { Image } from "astro:assets";

export interface Props {
    data: {
        name: string;
        picture: ImageMetadata;
        website: string;
        research: string;
    };
    body: any;
}

const { data, body } = Astro.props;
const { Content } = await render(body);

const SOCIALS = [
    {
        icon: "tdesign:assignment-user",
        name: "visit the human",
        url: data.website,
    },
    {
        icon: "tdesign:folder-search",
        name: "follow the research",
        url: data.research,
    },
];
---

<article
    class="flex flex-col sm:flex-row lg:flex-col items-center justify-center gap-10 bg-white p-8 xl:pt-14 border-b-4 border-figred"
>
    <div class="shrink-0 w-64 h-64">
        <Image class="w-full h-auto" src={data.picture} alt={data.name} />
    </div>
    <div class="shrink">
        <h3 class="font-bold text-3xl mb-1.5">{data.name}</h3>
        <div class="text-sm mb-4 text-pretty">
            <Content />
        </div>
        <div class="flex gap-2">
            {
                SOCIALS.map((social) => (
                    <a
                        class="text-figred flex content-center"
                        href={social.url}
                        target="_blank"
                    >
                        <Icon class="inline mr-2 text-2xl" name={social.icon} />
                        <span class="underline self-center">{social.name}</span>
                    </a>
                ))
            }
        </div>
    </div>
</article>
