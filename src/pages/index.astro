---
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";

import Hero from "@layouts/partials/Hero.astro";

import Divider from "@atoms/Divider.astro";
import Container from "@atoms/Container.astro";
import Card from "@atoms/Card.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import Research from "@components/Research.astro";
import Humans from "@components/Humans.astro";

import { intro, research, humans } from "@assets/pages/index.json";

const HUMANS_COLLECTION = await getCollection("humans");
const RESEARCH_COLLECTION = await getCollection("research");
---

<Layout>
    <Hero />
    <div id="anchor_intro"></div>
    <Divider />
    <article>
        <Container>
            <Headline icon={intro.icon} set:html={intro.headline} />
            <Leading set:html={intro.leading} />
            <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16">
                {
                    intro.aims.map((aim) => (
                        <Card icon={aim.icon} title={aim.title}>
                            <p class="leading-6" set:html={aim.description} />
                        </Card>
                    ))
                }
            </section>
        </Container>
    </article>
    <div id="anchor_research"></div>
    <Divider />
    <Container>
        <Headline icon={research.icon} set:html={research.headline} />
        <Leading set:html={research.leading} />
        <Research items={RESEARCH_COLLECTION} />
    </Container>
    <div id="anchor_humans"></div>
    <Divider />
    <Container>
        <Headline icon={humans.icon} set:html={humans.headline} />
        <Leading set:html={humans.leading} />
        <Humans items={HUMANS_COLLECTION} />
    </Container>
</Layout>
