---
import "@assets/site/styles.css";

import Navbar from "@layouts/partials/Navbar.astro";
import Footer from "@layouts/partials/Footer.astro";

import CFG from "@assets/site/config.json";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{`${CFG.meta.title}`}</title>
        <meta name="description" content={`${CFG.meta.subtitle}`} />
    </head>
    <body>
        <Navbar />
        <slot />
        <Footer />
    </body>
</html>
