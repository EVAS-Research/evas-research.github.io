---
import { Image } from "astro:assets";

import PHOTO_SQUARE from "@assets/images/hero.square.webp";
import PHOTO_LONG from "@assets/images/hero.long.webp";
import PHOTO_BACKGROUND from "@assets/images/hero.background.webp";
import LOGO_LEAF from "@assets/images/logo.partial.leaf.svg";

import * as HERO from "@assets/index.hero.md";
---

<div
    class="bg-cover bg-top py-16 px-8"
    style={`background-image: url(${PHOTO_BACKGROUND.src});`}
>
    <div class="relative container mx-auto parallax flex">
        <div class="z-20 -translate-z-16">
            <Image
                class="sm:hidden px-4 pt-2 pb-0 shadow-2xl"
                src={PHOTO_SQUARE}
                alt="EVAS: Ecological Validation of Artifical Simulacra ::. Research Cooperative"
            />
            <Image
                class="hidden sm:block pt-4 shadow-2xl"
                src={PHOTO_LONG}
                alt="EVAS: Ecological Validation of Artifical Simulacra ::. Research Cooperative"
            />
        </div>
         <div class="z-10 -left-96 translate-z-16">
            <Image class="w-96" src={LOGO_LEAF} alt="leaf-decotator-image" />
        </div>
        <div class="z-30 translate-z-64 top-48 md:top-96">
            <div class="flex flex-col justify-end text-shadow-lg">
                <h1
                    class="text-3xl font-serif text-eggwhite mb-0.5"
                >
                    {HERO.frontmatter.title}
                </h1>
                <span class="text-eggwhite font-thin tracking-wide"
                    >{HERO.frontmatter.subtitle}</span
                >
            </div>
        </div>
    </div>
</div>

<script>
    const parallax = function ({ smooth = 1 / 32 }) {
        const root = document.documentElement;

        document.addEventListener("mousemove", (event) => {
            const rotateX = (event.clientY - window.innerHeight / 2) * smooth;
            const rotateY = (event.clientX - window.innerWidth / 2) * -smooth;

            root.style.setProperty("--rotate-x", `${rotateX}deg`);
            root.style.setProperty("--rotate-y", `${rotateY}deg`);
        });
    };

    parallax({});

    const parallax_elements = document.querySelectorAll("div.parallax");
    parallax_elements.forEach((parallax_el) => {
        parallax_el.setAttribute("style", `height:${
            (parallax_el.children[1] as HTMLElement).offsetHeight * 1.1
        }px`);
    });

</script>
<style>
    :root {
        --rotate-y: 0;
        --rotate-x: 0;
    }

    .parallax {
        @apply flex transform-3d;

        transform: rotateX(var(--rotate-x)) rotateY(var(--rotate-y));
        transition: transform 0.8s cubic-bezier(0.1, 0.6, 0.2, 1);
        will-change: transform;
    }

    .parallax > * {
        @apply absolute flex items-center justify-center select-none;
    }
</style>
