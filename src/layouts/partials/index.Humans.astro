---
import { getCollection } from "astro:content";

import Container from "@atoms/Container.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import Human from "@components/Human.astro";

import { humans } from "@assets/page.index.json";
const COLLECTION = await getCollection("humans");
---

<Container>
    <Headline icon={humans.icon} set:html={humans.headline} />
    <Leading set:html={humans.leading} />
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        {
            COLLECTION.map((person) => (
                <Human {...person.data} content={person} />
            ))
        }
    </div>
</Container>
