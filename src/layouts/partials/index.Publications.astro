---
import { getCollection } from "astro:content";

import Container from "@atoms/Container.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import Publication from "@components/Publication.astro";

import { publications } from "@assets/page.index.json";
const COLLECTION = await getCollection("publications");
---

<Container>
    <Headline icon={"tdesign:folder-search"} set:html={publications.headline} />
    <Leading set:html={publications.leading} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
        {
            COLLECTION.map((article) => (
                <Publication {...article.data} content={article} />
            ))
        }
    </div>
</Container>
