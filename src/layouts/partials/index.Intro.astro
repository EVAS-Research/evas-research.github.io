---
import { Icon } from "astro-icon/components";

import Container from "@atoms/Container.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import { intro } from "@assets/page.index.json";
---

<article>
    <Container>
        <Headline icon={intro.icon} set:html={intro.headline} />
        <Leading set:html={intro.leading} />
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16">
            {
                intro.aims.map((aim) => (
                    <div class="border-l-4 lg:border-t-4 border-r-4 border-figred pl-10 pt-8 pr-8">
                        <h3 class="text-3xl font-semibold mb-2">
                            <Icon
                                class="inline mr-3 text-5xl text-figred"
                                name={aim.icon}
                            />
                            <span>{aim.title}</span>
                        </h3>
                        <p class="leading-6" set:html={aim.description} />
                    </div>
                ))
            }
        </section>
    </Container>
</article>
