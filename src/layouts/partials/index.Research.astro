---
import { getCollection } from "astro:content";

import Container from "@atoms/Container.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import Research from "@components/Research.astro";

import { research } from "@assets/page.index.json";
const COLLECTION = await getCollection("research");
---

<Container>
    <Headline icon={research.icon} set:html={research.headline} />
    <Leading set:html={research.leading} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
        {
            COLLECTION.map((article) => (
                <Research {...article.data} content={article} />
            ))
        }
    </div>
</Container>
