---
import { getCollection } from "astro:content";

import Container from "@atoms/Container.astro";
import Headline from "@atoms/Headline.astro";
import Leading from "@atoms/Leading.astro";

import Person from "@components/Person.astro";

import { people } from "@assets/page.index.json";
const COLLECTION = await getCollection("people");
---

<Container>
    <Headline icon={"tdesign:usergroup"} set:html={people.headline} />
    <Leading set:html={people.leading} />
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        {
            COLLECTION.map((person) => (
                <Person {...person.data} content={person} />
            ))
        }
    </div>
</Container>
