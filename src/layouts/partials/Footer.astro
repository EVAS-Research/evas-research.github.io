---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";

import Container from "@atoms/Container.astro";

import CFG from "@assets/site/config.json";
import LOGO from "@assets/site/images/logo.mono.white.svg";

const backerImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/site/images/backer/*.svg",
);
---

<footer>
    <Container background={"primary"} spacing={"medium"} gap={"medium"}>
        <div class="flex justify-center mb-8">
            <Image
                class="h-86"
                src={LOGO}
                alt={`${CFG.meta.title} | ${CFG.meta.subtitle}`}
            />
        </div>
        <div class="flex justify-center gap-6">
            {
                CFG.footer.icon_menu.map((item) => (
                    <a
                        class="text-white text-2xl"
                        href={item.url}
                        target="_blank"
                    >
                        <Icon name={item.icon} />
                    </a>
                ))
            }
        </div>
        <div class="h-4"></div>
        <div class="flex justify-center">
            <span class="text-eggwhite italic">
                EVAS is supported by the following universities/labs:
            </span>
        </div>
        <div class="flex flex-row justify-center items-center gap-14">
            {
                CFG.footer.backer_menu.map((item) => (
                    <a
                        class="content-center max-w-52"
                        href={item.url}
                        target="_blank"
                    >
                        <Image
                            src={backerImages[item.logo]()}
                            alt={item.name}
                            class="h-24 pb-4"
                            inferSize={true}
                        />
                        <span class="text-white text-sm">{item.name}</span>
                    </a>
                ))
            }
        </div>
        <div class="h-4"></div>
        <div
            class="flex gap-1.5 justify-center text-xs tracking-wide font-light italic text-white"
        >
            <span>source code:</span>
            <a class="underline" href={CFG.footer.source_url} target="_blank"
                >{CFG.footer.source_url}</a
            >
            <span
                >build with <a
                    class="underline"
                    href="https://astro.build/"
                    target="_blank"
                    referrerpolicy="no-referrer">Astro.js</a
                ></span
            >
        </div>
    </Container>
</footer>
