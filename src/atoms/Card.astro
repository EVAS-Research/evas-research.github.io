---
import { Icon } from "astro-icon/components";

interface Props {
    icon?: string | null;
    title: string;
}

const { icon = null, title } = Astro.props;
---

<div
    class="border-l-4 lg:border-t-4 border-r-4 border-figred pl-10 pr-8 lg:pt-8"
>
    <h3 class="text-3xl font-semibold mb-2">
        {icon && <Icon class="inline mr-3 text-5xl text-figred" name={icon} />}
        <span>{title}</span>
    </h3>
    <slot />
</div>
