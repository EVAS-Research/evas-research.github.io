---
interface Props {
    background?: "white" | "dark" | "primary";
    spacing?: "none" | "small" | "medium" | "large";
    gap?: "none" | "small" | "medium" | "large";
    flow?: "flex-col" | "flex-row";
}

const bg_variants = {
    white: "bg-eggwhite",
    dark: "bg-coldgrey",
    primary: "bg-figred",
};

const spacing_variants = {
    none: "py-0",
    small: "py-4",
    medium: "py-8",
    large: "py-16",
};

const gap_variants = {
    none: "gap-0",
    small: "gap-2",
    medium: "gap-4",
    large: "gap-8",
};

const {
    background = "white",
    spacing = "large",
    gap = "large",
    flow = "flex-col",
} = Astro.props;
---

<article
    class:list={[bg_variants[background], spacing_variants[spacing], "px-4"]}
>
    <div
        class:list={[
            [gap_variants[gap], flow],
            "relative container mx-auto flex justify-center content-center",
        ]}
    >
        <slot />
    </div>
</article>
